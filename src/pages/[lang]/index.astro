---
import Base from '../../layouts/Base.astro';
import CommissionHome from '../../components/CommissionHome.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

const locale = Astro.currentLocale || Astro.params.lang || 'en';
---

<Base
  title="Raptoriano · Commissions Open"
  description="Painterly digital illustration commissions by Raptoriano."
  image="/images/placeholders/commission-hero-1045x765.jpg"
  locale={locale}
  immersive
>
  <CommissionHome locale={locale} />
</Base>
