// Archive images are read directly from public/images/portfolio/pre2019.
// The pre2010 subfolder stays hidden until the 2019 archive is expanded.
const archiveImageFiles = (folder: string) => readdirSync(new URL(folder, import.meta.url), { withFileTypes: true })
	.filter((entry) => entry.isFile() && ['.jpg', '.jpeg', '.png', '.webp'].includes(extname(entry.name).toLowerCase()))
	.map((entry) => entry.name)
	.sort((a, b) => a.localeCompare(b));
const pre2019Files = archiveImageFiles('../../public/images/portfolio/pre2019');
const pre2010Files = archiveImageFiles('../../public/images/portfolio/pre2019/pre2010');
const pre2019Metadata: Record<string, { titles: { es: string; en: string }; descriptions: { es: string; en: string } }> = {
	'616444735_18163454371403675_477673644611328108_n.jpg': { titles: { es: 'Pintor', en: 'Painter' }, descriptions: { es: 'Ilustración editorial de un pintor con una paleta de colores.', en: 'Editorial illustration of a painter holding a color palette.' } },
