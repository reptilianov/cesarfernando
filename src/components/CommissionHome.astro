	{ id: 'all', label: c.allWorks },
	{ id: 'portrait', label: es ? 'Retrato' : 'Portraits' },
	{ id: 'character', label: es ? 'Personajes' : 'Characters' },
	{ id: 'narrative', label: es ? 'Narrativo' : 'Narrative' },
	{ id: 'study', label: es ? 'Estudios' : 'Studies' },
];
// Paste each novel's URL into its Spanish and English fields when ready.
const narrativeProjects = [
	{
		id: 'blood-for-the-abi',
		titles: { es: 'Blood for the Abi', en: 'Blood for the Abi' },
		links: { es: '', en: '' },
		description: es
			? 'Novela en español e inglés. Añade aquí una breve descripción.'
			: 'Novel in English and Spanish. Add a short description here.',
	},
	{
		id: 'last-star-of-babylon',
		titles: {
			es: 'La última estrella de Babilonia',
			en: 'The Last Star of Babylon',
		},
		links: { es: '', en: '' },
		description: es
			? 'Novela en español e inglés. Añade aquí una breve descripción.'
			: 'Novel in English and Spanish. Add a short description here.',
	},
];
const storyLanguages = ['es', 'en'] as const;
---

<main class="commission-home">
	<header class="site-header">
		<a
			class="wordmark"
			href={'/' + locale + '/'}>
			<img
				class="siteLogo"
				src="/images/interface/RaptorianoLogo-b.webp"
			/>
		</a>
		<nav aria-label={es ? 'Navegación de comisiones' : 'Commission navigation'}>
			<a href="#portfolio">{es ? 'Portafolio' : 'Portfolio'}</a><a href="#about"
				>{c.about}</a
			><a href="#narrative">{c.narrative}</a><a href="#prices"
				>{es ? 'Precios' : 'Prices'}</a
			><a href="#authors">{c.authors}</a><a href="#process"
				>{es ? 'Proceso' : 'Process'}</a
			><a href="#faq">FAQ</a><a href="#contact">{es ? 'Contacto' : 'Contact'}</a
			>
		</nav><a
			class="locale"
			href={es ? '/en/' : '/es/'}
			>{es ? 'EN' : 'ES'}</a
		>
	</header>
	<section
		class="hero"
		aria-labelledby="hero-title">
		<div>
			<p class="eyebrow">{c.open}</p><h1 id="hero-title">Raptoriano</h1><p
				class="intro">
				{c.intro}
			</p><p class="krita">{c.krita}</p><div class="actions">
				<a
					class="button primary"
					href="#contact"
					>{c.request}</a
				><a
					class="button"
					href="#prices"
					>{c.prices}</a
				>
			</div>
		</div>
	</section>
	<div class="shell">
		<section
			id="portfolio"
			class="section portfolio"
			data-projects={JSON.stringify([...portfolio, ...pre2019Portfolio, ...pre2010Portfolio])}
			data-categories={JSON.stringify(categories)}
			data-copy={JSON.stringify({
				close: c.close,
				share: c.share,
				copied: es ? 'Enlace copiado' : 'Link copied',
			})}>
			<div class="heading">
				<p>{c.portfolioLead}</p><h2>{c.portfolio}</h2>
			</div><div class="portfolio-tools">
				<span>{c.filterBy}</span><div
					class="portfolio-filters"
					role="group"
					aria-label={c.filterBy}>
					{
						categories.map((category) => (
							<button
								class="filter-button"
								type="button"
								data-filter={category.id}
								aria-pressed={category.id === 'all' ? 'true' : 'false'}>
								{category.label}
							</button>
						))
					}
				</div>
			</div><div class="portfolio-grid">
				{
					portfolio.map((piece) => (
						<article
							id={piece.id}
							class="portfolio-card"
							data-category={piece.category}>
							<>
								<button
									class="portfolio-open"
									type="button"
									data-project={piece.id}
									aria-label={`${c.details}: ${piece.title}`}>
									<>
										<img
											src={piece.thumbnail}
											alt={`${piece.title} thumbnail`}
											loading="lazy"
										/>
										<span class="portfolio-overlay">
											{c.details}
											<span aria-hidden="true">↗</span>
										</span>
									</>
								</button>
								<div class="portfolio-card-meta">
									<>
										<div>
											<>
												<h3>{piece.title}</h3>
												<span class="category-label">
													{
														categories.find(
															(category) => category.id === piece.category,
														)?.label
													}
												</span>
											</>
										</div>
										<button
											class="share-button"
											type="button"
											data-share={piece.id}
											aria-label={`${c.share}: ${piece.title}`}
											title={c.share}>
											↗
										</button>
									</>
								</div>
							</>
						</article>
					))
				}
			</div><section class="pre2019-section" aria-labelledby="pre2019-title">
				<div class="pre2019-heading"><div><p class="eyebrow">{es ? 'Archivo' : 'Archive'}</p><h3 id="pre2019-title">{c.pre2019Title}</h3><p>{c.pre2019Lead}</p></div></div>
				<div class="portfolio-grid archive-grid pre2019-grid">
					{pre2019Portfolio.map((piece, index) => <article id={piece.id} class="portfolio-card pre2019-card" data-archive-card="pre2019" hidden={index > 5}><button class="portfolio-open" type="button" data-project={piece.id} aria-label={`${c.details}: ${piece.title}`}><img src={piece.thumbnail} alt={`${piece.title} thumbnail`} loading="lazy" /><span class="portfolio-overlay">{c.details}<span aria-hidden="true">↗</span></span></button><div class="portfolio-card-meta"><div><h3>{piece.title}</h3><span class="category-label">{es ? 'Antes de 2019' : 'Before 2019'}</span></div><button class="share-button" type="button" data-share={piece.id} aria-label={`${c.share}: ${piece.title}`} title={c.share}>↗</button></div></article>)}
				</div><button class="button pre2019-toggle" type="button" data-archive-toggle="pre2019" data-show-more={c.showMore} data-show-less={c.showLess} aria-expanded="false">{c.showMore}</button>
			</section><section class="pre2019-section pre2010-section" data-pre2010-section aria-labelledby="pre2010-title" hidden>
				<div class="pre2019-heading"><div><p class="eyebrow">{es ? 'Archivo temprano' : 'Early archive'}</p><h3 id="pre2010-title">{c.pre2010Title}</h3><p>{c.pre2010Lead}</p></div></div>
				<div class="portfolio-grid archive-grid pre2010-grid">
					{pre2010Portfolio.map((piece, index) => <article id={piece.id} class="portfolio-card pre2019-card pre2010-card" data-archive-card="pre2010" hidden={index > 5}><button class="portfolio-open" type="button" data-project={piece.id} aria-label={`${c.details}: ${piece.title}`}><img src={piece.thumbnail} alt={`${piece.title} thumbnail`} loading="lazy" /><span class="portfolio-overlay">{c.details}<span aria-hidden="true">↗</span></span></button><div class="portfolio-card-meta"><div><h3>{piece.title}</h3><span class="category-label">{es ? 'Antes de 2010' : 'Before 2010'}</span></div><button class="share-button" type="button" data-share={piece.id} aria-label={`${c.share}: ${piece.title}`} title={c.share}>↗</button></div></article>)}
				</div><button class="button pre2019-toggle" type="button" data-archive-toggle="pre2010" data-show-more={c.showMore} data-show-less={c.showLess} aria-expanded="false">{c.showMore}</button>
			</section><dialog
				class="portfolio-dialog"
				aria-labelledby="dialog-title">
				<button
					class="dialog-close"
					type="button"
					aria-label={c.close}
					>×</button
				><div class="dialog-layout">
					<img
						class="dialog-image"
						src=""
						alt=""
					/><div class="dialog-copy">
						<p class="eyebrow dialog-category"></p><h2 id="dialog-title"></h2><div class="youtube-video" hidden><iframe
							title=""
							src=""
							loading="lazy"
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
							referrerpolicy="strict-origin-when-cross-origin"
							allowfullscreen></iframe></div>
					</div>
				</div>
			</dialog>
		</section>
		<section
			id="about"
			class="section about-section">
			<div class="about-panel">
				<p class="eyebrow">{c.about}</p><h2>{c.about}</h2><p>{c.aboutText}</p><p
					class="about-signature">
					César Fernando Pérez Velasco <span>— Raptoriano</span>
				</p>
			</div>
		</section>
		<section
			id="narrative"
			class="section narrative-section">
			<div class="heading">
				<p>{c.narrativeLead}</p><h2>{c.narrative}</h2>
			</div><div class="narrative-grid">
				{
					narrativeProjects.map((project) => (
						<article class="narrative-card">
							<>
								<p class="eyebrow">{es ? 'Novela' : 'Novel'}</p>
								<h3>{project.titles[locale === 'es' ? 'es' : 'en']}</h3>
								<p>{project.description}</p>
								<div class="novel-links">
									{storyLanguages.map((language) =>
										project.links[language] ? (
											<a
												class="button"
												href={project.links[language]}
												target="_blank"
												rel="noopener noreferrer">
												{language === 'es' ? c.spanish : c.english} ↗
											</a>
										) : (
											<span class="link-placeholder">
												{language === 'es' ? c.spanish : c.english}: {c.addLink}
											</span>
										),
									)}
								</div>
							</>
						</article>
					))
				}
			</div>
		</section>
		<section
			id="prices"
			class="section">
			<div class="heading"><p>{c.priceLead}</p><h2>{c.priceTitle}</h2></div><div
				class="cards">
				{
					prices.map(([name, price, detail]) => (
						<article>
							<>
								<h3>{name}</h3>
								<p>{detail}</p>
								<strong>{price}</strong>
							</>
						</article>
					))
				}
			</div>
		</section>
		<section
			id="authors"
			class="section author-package">
			<div class="heading">
				<p>{c.authorLead}</p><h2>{c.authorTitle}</h2>
			</div><article class="author-card">
				<div><h3>{c.authors}</h3><p>{c.authorTerms}</p></div><strong
					>{c.authorPrice}</strong
				><a
					class="button primary"
					href={`mailto:cefev.diseno@gmail.com?subject=${encodeURIComponent(es ? 'Paquete de ilustración para libro' : 'Book illustration package')}`}
					>{c.authorCta}</a
				>
			</article>
		</section>
		<section class="section split">
			<div>
				<h2>{c.extras}</h2><ul>{extras.map((item) => <li>{item}</li>)}</ul>
			</div><aside class="notice">
				<p>{es ? 'Antes de pagar' : 'Before payment'}</p><strong
					>{
						es
							? 'El presupuesto final siempre se confirma contigo antes de solicitar el pago.'
							: 'The final quote is always confirmed with you before payment is requested.'
					}</strong
				>
			</aside>
		</section>
		<section
			id="process"
			class="section">
			<h2>{c.process}</h2><ol class="steps">
				{
					steps.map((step, index) => (
						<li>
							<span>{String(index + 1).padStart(2, '0')}</span>
							{step}
						</li>
					))
				}
			</ol>
		</section>
		<section class="section split">
			<div>
				<h2>{c.fit}</h2><ul>{fit.map((item) => <li>{item}</li>)}</ul>
			</div><div>
				<h2>{c.no}</h2><ul>{notAccepted.map((item) => <li>{item}</li>)}</ul>
			</div>
		</section>
		<section
			id="faq"
			class="section faq">
			<h2>{c.faq}</h2>{
				faq.map(([question, answer]) => (
					<details>
						<>
							<summary>{question}</summary>
							<p>{answer}</p>
						</>
					</details>
				))
			}
		</section>
		<section
			id="contact"
			class="section contact">
			<div>
				<p class="eyebrow">{c.open}</p><h2>{c.contact}</h2><p>
					{c.contactLead}
				</p><a
					class="button primary"
					href="mailto:cefev.diseno@gmail.com"
					>{c.email}</a
				>
			</div><aside>
				<h3>Book and publishing design</h3><p>
					Custom title logos, ebook covers and KDP formatting are available as
					separate design services.
				</p><a
					href="https://www.commissions.gg/raptoriano"
					target="_blank"
					rel="noopener noreferrer"
					>{c.designLink}</a
				>
			</aside>
		</section>
	</div>
</main>
<script>
	const section = document.querySelector<HTMLElement>(
		'#portfolio[data-projects]',
	);
	if (section) {
		const projects = JSON.parse(section.dataset.projects ?? '[]') as Array<{
			id: string;
			title: string;
			category: string;
			description: string;
			finalImage: string;
			youtubeVideo?: string;
		}>;
		const categories = JSON.parse(section.dataset.categories ?? '[]') as Array<{
			id: string;
			label: string;
		}>;
		const copy = JSON.parse(section.dataset.copy ?? '{}') as {
			close: string;
			share: string;
			copied: string;
		};
		const dialog =
			section.querySelector<HTMLDialogElement>('.portfolio-dialog');
		const image = dialog?.querySelector<HTMLImageElement>('.dialog-image');
		const title = dialog?.querySelector<HTMLElement>('#dialog-title');
		const category = dialog?.querySelector<HTMLElement>('.dialog-category');
		const videoBox = dialog?.querySelector<HTMLElement>('.youtube-video');
		const videoFrame = videoBox?.querySelector<HTMLIFrameElement>('iframe');

		section
			.querySelectorAll<HTMLButtonElement>('[data-filter]')
			.forEach((filter) => {
				filter.addEventListener('click', () => {
					const selected = filter.dataset.filter;
					section
						.querySelectorAll<HTMLButtonElement>('[data-filter]')
						.forEach((button) =>
							button.setAttribute('aria-pressed', String(button === filter)),
						);
					section
						.querySelectorAll<HTMLElement>('.portfolio-card')
						.forEach((card) => {
							card.hidden =
								selected !== 'all' && card.dataset.category !== selected;
						});
				});
			});

		section
			.querySelectorAll<HTMLButtonElement>('[data-archive-toggle]')
			.forEach((button) => {
				button.addEventListener('click', () => {
					const expanded = button.getAttribute('aria-expanded') === 'true';
					const archive = button.dataset.archiveToggle;
					section
						.querySelectorAll<HTMLElement>(`[data-archive-card="${archive}"]`)
						.forEach((card, index) => { card.hidden = !expanded && index > 5; });
					button.setAttribute('aria-expanded', String(!expanded));
					button.textContent = expanded ? button.dataset.showMore ?? '' : button.dataset.showLess ?? '';
					if (archive === 'pre2019') {
						const pre2010Section = section.querySelector<HTMLElement>('[data-pre2010-section]');
						if (pre2010Section) pre2010Section.hidden = expanded;
					}
				});
			});

		section
			.querySelectorAll<HTMLButtonElement>('[data-project]')
			.forEach((button) => {
				button.addEventListener('click', () => {
					const project = projects.find(
						(item) => item.id === button.dataset.project,
					);
					if (
						!project ||
						!dialog ||
						!image ||
					!title ||
					!category
					)
						return;
					image.src = project.finalImage;
					image.alt = project.title;
					title.textContent = project.title;
					category.textContent =
						categories.find((item) => item.id === project.category)?.label ??
						project.category;
					const videoId = getYouTubeVideoId(project.youtubeVideo ?? '');
					if (videoBox && videoFrame && videoId) {
						videoFrame.src = `https://www.youtube-nocookie.com/embed/${videoId}`;
						videoFrame.title = `${project.title} speedpainting`;
						videoBox.hidden = false;
					} else if (videoBox && videoFrame) {
						videoFrame.removeAttribute('src');
						videoBox.hidden = true;
					}
					dialog.showModal();
				});
			});

		dialog
			?.querySelector<HTMLButtonElement>('.dialog-close')
			?.addEventListener('click', () => dialog.close());
		dialog?.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});
		dialog?.addEventListener('close', () => videoFrame?.removeAttribute('src'));

		section
			.querySelectorAll<HTMLButtonElement>('[data-share]')
			.forEach((button) => {
				button.addEventListener('click', async () => {
					const project = projects.find(
						(item) => item.id === button.dataset.share,
					);
					if (!project) return;
					const url = new URL(
						`#${project.id}`,
						window.location.href,
					).toString();
					if (navigator.share) {
						try {
							await navigator.share({
								title: project.title,
								text: project.description,
								url,
							});
						} catch (error) {
							if (error instanceof Error && error.name !== 'AbortError')
								console.error(error);
						}
					} else if (navigator.clipboard) {
						await navigator.clipboard.writeText(url);
						button.setAttribute('aria-label', copy.copied);
						button.title = copy.copied;
						window.setTimeout(() => {
							button.setAttribute(
								'aria-label',
								`${copy.share}: ${project.title}`,
							);
							button.title = copy.share;
						}, 1800);
					}
				});
			});
	}

	function getYouTubeVideoId(value: string): string | null {
		try {
			const url = new URL(value);
			const host = url.hostname.replace(/^www\./, '');
			let id = '';
			if (host === 'youtu.be') id = url.pathname.slice(1).split('/')[0] ?? '';
			else if (host === 'youtube.com' || host === 'm.youtube.com' || host === 'youtube-nocookie.com') {
				id = url.searchParams.get('v') ?? url.pathname.match(/^\/(?:embed|shorts)\/([^/]+)/)?.[1] ?? '';
			}
			return /^[\w-]{11}$/.test(id) ? id : null;
		} catch {
			return null;
		}
	}
</script>
