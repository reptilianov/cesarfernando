const prices = es
	? [
			['Retrato / busto', 'Desde $85 USD', 'Rostro, hombros y expresión.'],
			[
				'Medio cuerpo',
				'Desde $125 USD',
				'Hasta la cintura, con espacio para gesto y vestuario.',
			],
			['Cuerpo completo', 'Desde $175 USD', 'Un personaje completo.'],
		]
	: [
			['Portrait / bust', 'From $85 USD', 'Face, shoulders, and expression.'],
			[
				'Half body',
				'From $125 USD',
				'Waist-up, with room for gesture and costume.',
			],
			['Full body', 'From $175 USD', 'One full character.'],
		];
const extras = es
	? [
			'Personaje adicional: +75%',
			'Fondo o ambiente detallado: desde +$60',
			'Outfit alterno o versión nude con la misma pose: desde +40%',
			'Uso comercial: se cotiza por separado',
			'Armaduras, joyería, criaturas, props complejos y diseños elaborados incrementan el presupuesto.',
		]
	: [
			'Additional character: +75%',
			'Detailed background or environment: from +$60',
			'Alternate outfit or same-pose nude version: from +40%',
			'Commercial use: quoted separately',
			'Armor, jewelry, creatures, complex props, and elaborate designs increase the quote.',
