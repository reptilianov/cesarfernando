const pre2019Portfolio = pre2019Files.map((file, index) => {
	const number = String(index + 1).padStart(2, '0');
	const imageName = basename(file, extname(file));
	const metadata = pre2019Metadata[file];
	return {
		id: `pre2019-${number}`,
		title: metadata ? (es ? metadata.titles.es : metadata.titles.en) : (es ? `Imagen anterior ${number}` : `Earlier image ${number}`),
		category: 'pre-2019',
		description: metadata ? (es ? metadata.descriptions.es : metadata.descriptions.en) : (es ? 'Imagen del archivo anterior a 2019.' : 'Image from the pre-2019 archive.'),
		thumbnail: `/images/portfolio/pre2019/thumbs/${imageName}.webp`,
		finalImage: `/images/portfolio/pre2019/${file}`,
	};
});
