	'625038192_18149517409447351_696622445701896923_n.jpg': { titles: { es: 'Conejo', en: 'Rabbit' }, descriptions: { es: 'Personaje de conejo con una estética dinámica de cómic.', en: 'Rabbit character with a dynamic comic-book aesthetic.' } },
	'625050147_18143826268412068_6470228837908340527_n.jpg': { titles: { es: 'Residencias ecosustentables', en: 'Sustainable Residences' }, descriptions: { es: 'Símbolo ilustrado para un proyecto de residencias ecosustentables.', en: 'Illustrated symbol for a sustainable residences project.' } },
	'625051126_18380377108155826_3944280962404893882_n.jpg': { titles: { es: 'Grizzly Burger & Fries', en: 'Grizzly Burger & Fries' }, descriptions: { es: 'Mascota e identidad para una hamburguesería.', en: 'Mascot and identity for a burger restaurant.' } },
