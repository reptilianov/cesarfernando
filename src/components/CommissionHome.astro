	'619147337_18099182467881168_6224745508823702925_n.jpg': { titles: { es: 'Gato lector', en: 'Reading Cat' }, descriptions: { es: 'Personaje infantil de un gato sentado sobre una pila de libros.', en: 'Children’s character illustration of a cat sitting on a stack of books.' } },
