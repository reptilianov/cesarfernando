	? [
			'Mecha o maquinaria altamente técnica',
			'Personajes furry o antropomórficos',
			'Imitación exacta del estilo de un artista vivo',
			'Personajes menores de edad en cualquier contexto',
		]
	: [
			'Mecha or highly technical machinery',
			'Furry / anthropomorphic characters',
			'Exact imitation of a living artist’s style',
			'Underage characters in any context',
		];
const faq = es
	? [
			[
				'¿Usas IA?',
				'La pieza final está dibujada y pintada por mí en Krita. Puedo consultar referencias auxiliares para detalles, pero nunca se incorporan a la obra final ni sustituyen el dibujo.',
			],
